# Copy to terraform.tfvars (which is git-ignored) and edit.
github_repo  = "YOUR-GITHUB-USER/booking-webhook-relay"
budget_email = "you@example.com"

# Optional:
# region             = "ap-south-1"
# monthly_budget_usd = 10
# domain_name        = "relay.example.com"   # then point an A record at the elastic_ip output
# ingress_cidrs      = ["203.0.113.7/32"]    # restrict to your own IP to keep the demo private
# existing_oidc_provider_arn = ""            # set if this account already has a GitHub OIDC provider
