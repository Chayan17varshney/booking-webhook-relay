# Copy to .env for local runs. Never commit .env or real keys.
PORT=3000
WEBHOOK_SECRET=change-me
# Key required (X-API-Key header) to read GET /events. Use a long random value.
ADMIN_API_KEY=change-me-too
DEFAULT_PHONE_COUNTRY=IN
POSTGRES_PASSWORD=relay_dev_password
DATABASE_URL=postgres://relay:relay_dev_password@localhost:5432/relay
# Redis is optional: without it, Postgres still prevents duplicates and there is no rate limiting.
REDIS_URL=redis://localhost:6379
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
# Number of reverse proxies in front of the app (e.g. 1 behind an AWS load balancer). 0 = none.
TRUST_PROXY=0
# CRM forwarding is optional: without CRM_BASE_URL, events are stored but not forwarded.
CRM_BASE_URL=http://localhost:4000
CRM_API_KEY=dev-crm-key
FORWARD_MAX_ATTEMPTS=5
# Mock CRM only: fraction of requests that fail with 503 (try 0.5 to see retries)
MOCK_CRM_FAIL_RATE=0
